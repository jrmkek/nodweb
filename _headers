/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/shared/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Client drafts (one block per client; Pages matched no path with two splats): fonts never change; images and models may be swapped for the
# client's own files under the same names, so a month rather than immutable.
/clients/est-rise-architecture/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/clients/est-rise-architecture/assets/*
  Cache-Control: public, max-age=2592000

/clients/starthouse/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/clients/starthouse/assets/*
  Cache-Control: public, max-age=2592000

/clients/valuesteel/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/clients/valuesteel/assets/*
  Cache-Control: public, max-age=2592000

# CSS/JS keep their filenames when they change, so they must be revalidated
# on every request (cheap 304 via ETag). A long max-age here let Cloudflare's
# edge keep serving a week-old fonts-nodweb.css after a deploy.
/shared/css/*
  Cache-Control: public, max-age=0, must-revalidate

/shared/js/*
  Cache-Control: public, max-age=0, must-revalidate
